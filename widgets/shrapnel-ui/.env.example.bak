# shrapnel-ui — live backend endpoint
#
# The environment-selected URL is authoritative. Defaults to the live
# shrapnel-srv:3118 (the EAV object/binding service). Override per-deploy
# without source edits.
VITE_SHRAPNEL_SRV_URL=http://localhost:3118

# Endpoint overrides (the UI's endpoint dialog persisting to localStorage)
# are GATED behind this flag. When unset, a stale saved URL can never mask
# the .env-selected backend. Set to true only when you want operators to be
# able to redirect the UI at another shrapnel-srv instance.
# VITE_SHRAPNEL_ALLOW_OVERRIDE=false
