# peb-ui runtime configuration — environment-selected mode is authoritative.
#
# Mode: live by default; set VITE_PEB_API_MODE=mock only for the in-memory
# simulation. There is no localStorage override in peb-ui, so the env default
# always wins at startup.
VITE_PEB_API_MODE=live

# Observability API (peb-srv:3111) — health / events / transactions / state
# reads. The UI's live reads all go through /api/peb/* on this server.
VITE_PEB_API_BASE_URL=http://localhost:3111

# PEB kernel (Python, :8098) — the admission / state / hash contract. Kept
# separate from the 3111 observability contract: admission actions POST to
# /api/v1/peb/transaction, health at /actuator/health, hash at
# /api/v1/peb/state/hash.
VITE_PEB_KERNEL_URL=http://localhost:8098
